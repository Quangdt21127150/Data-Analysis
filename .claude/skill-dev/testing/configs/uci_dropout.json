{
  "project": "UCI Predict Students' Dropout - sàng lọc nguy cơ bỏ học tại mốc cuối học kỳ 1",
  "data_path": "../datasets/uci_dropout.csv",
  "out_dir": "../results/uci_dropout/output",
  "target": {"column": "Target", "type": "classes", "positive_classes": ["Dropout"]},
  "features": {
    "numeric": ["Application order", "Previous qualification (grade)", "Admission grade",
                "Curricular units 1st sem (credited)", "Curricular units 1st sem (enrolled)", "Curricular units 1st sem (evaluations)",
                "Curricular units 1st sem (approved)", "Curricular units 1st sem (grade)", "Curricular units 1st sem (without evaluations)",
                "Unemployment rate", "Inflation rate", "GDP"],
    "categorical": ["Application mode", "Course", "Daytime/evening attendance", "Previous qualification"]
  },
  "exclude": {
    "leakage": ["Curricular units 2nd sem (credited)", "Curricular units 2nd sem (enrolled)", "Curricular units 2nd sem (evaluations)",
                "Curricular units 2nd sem (approved)", "Curricular units 2nd sem (grade)", "Curricular units 2nd sem (without evaluations)"],
    "sensitive": ["Marital status", "Nacionality", "Mother's qualification", "Father's qualification", "Mother's occupation", "Father's occupation",
                  "Displaced", "Educational special needs", "Debtor", "Tuition fees up to date", "Gender", "Age at enrollment", "International",
                  "Scholarship holder"],
    "other": []
  },
  "fairness_audit": ["Gender", "Age at enrollment"],
  "capacity": 0.30, "alt_capacity": 0.15, "seed": 2026, "test_size": 0.2, "cv_folds": 5, "cv_repeats": 5,
  "success": {"auc": 0.70, "recall": 0.60, "max_recall_gap": 0.10, "reduction": 0.3333}
}
